{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pearconnect-session-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pearconnect.mellozone.site/api/session*", "zone_name": "mellozone.site" }],
  "vars": { "SITE_ORIGIN": "https://pearconnect.mellozone.site" },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "StreamSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamSession"] }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "41002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "invocation_logs": false } }
}
