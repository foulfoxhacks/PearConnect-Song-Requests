  "author": "Aleksandr \"Sammy\" Freyermuth (foulfoxhacks)",
  "repository": {
    "type": "git",
    "url": "https://github.com/foulfoxhacks/PearConnect-Song-Requests.git"
  },
  "bugs": {
    "url": "https://github.com/foulfoxhacks/PearConnect-Song-Requests/issues"
  },
  "homepage": "https://github.com/foulfoxhacks/PearConnect-Song-Requests#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.3",
    "youtube-chat": "^2.2.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "body-parser": "1.20.6"
  },
