  "description": "Shared song-request engine for Pear Desktop with Simple TikFinity, Advanced Streamer.bot, desktop and CLI interfaces.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:dry-run": "node src/index.js --dry-run",
    "auth": "node src/auth.js",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "build:streamerbot": "node scripts/build-streamerbot.mjs",
    "check:streamerbot": "node scripts/build-streamerbot.mjs --check",
    "test:streamerbot": "node scripts/test-streamerbot.mjs",
    "desktop": "node scripts/desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "package:win": "node scripts/package-desktop.mjs"
  },
  "keywords": [
