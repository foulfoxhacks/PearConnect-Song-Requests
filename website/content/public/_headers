/*
  X-Content-Type-Options: nosniff
  X-Robots-Tag: follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/404
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex
